* {
  box-sizing: border-box;
}

body {
  margin: 0;
  min-height: 100vh;
  overflow: hidden;

  display: flex;
  align-items: center;
  justify-content: center;

  color: #ffffff;
  background: #000000;

  font-family: "Courier New", monospace;
  image-rendering: pixelated;
}

main {
  width: min(94vw, 900px);
  text-align: center;
}

h1 {
  margin: 0 0 12px;

  color: #ffffff;
  font-family: "Courier New", monospace;
  font-size: clamp(24px, 5vw, 42px);
  font-weight: bold;
  letter-spacing: 3px;
  text-transform: uppercase;

  text-shadow: 4px 4px 0 #703800;
}

.game {
  position: relative;
  overflow: hidden;

  border: 6px solid #ffffff;
  border-radius: 0;

  background: #000000;
  box-shadow:
    8px 8px 0 #703800,
    0 0 0 4px #703800;
}

/* Efeito de tela antiga */
.game::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background: repeating-linear-gradient(
    to bottom,
    rgba(255, 255, 255, 0.04) 0px,
    rgba(255, 255, 255, 0.04) 2px,
    transparent 2px,
    transparent 5px
  );
}

canvas {
  display: block;
  width: 100%;
  height: auto;

  cursor: crosshair;
  touch-action: none;

  image-rendering: pixelated;
  image-rendering: crisp-edges;
}

.info {
  display: flex;
  justify-content: space-between;
  gap: 15px;

  margin-top: 18px;

  color: #ffffff;
  font-size: 14px;
  font-weight: bold;
  text-transform: uppercase;
}

.info b {
  color: #ffb000;
}

p {
  margin: 12px 0 0;

  color: #aaaaaa;
  font-size: 12px;
  text-transform: uppercase;
}

@media (max-width: 600px) {
  .info {
    font-size: 10px;
  }

  .game {
    border-width: 4px;
    box-shadow:
      5px 5px 0 #703800,
      0 0 0 3px #703800;
  }
}
